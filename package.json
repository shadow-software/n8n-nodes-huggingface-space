{
  "name": "n8n-nodes-huggingface-space",
  "version": "1.1.0",
  "description": "Run inference on any Hugging Face Gradio Space from n8n \u2014 curated catalog with fallbacks, Custom Space mode, and Catalog Overlay so you can prepend your own private model forks without forking the node.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "huggingface",
    "hugging-face",
    "gradio",
    "ai",
    "catalog-overlay",
    "private-spaces",
    "text-to-image",
    "text-to-video",
    "text-to-music",
    "text-to-speech",
    "llm",
    "moderation",
    "flux",
    "stable-diffusion"
  ],
  "license": "MIT",
  "homepage": "https://github.com/shadow-software/n8n-nodes-huggingface-space",
  "author": {
    "name": "Shadow Software",
    "email": "info@shadowsoftware.com",
    "url": "https://shadowsoftware.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shadow-software/n8n-nodes-huggingface-space.git"
  },
  "bugs": {
    "url": "https://github.com/shadow-software/n8n-nodes-huggingface-space/issues"
  },
  "engines": {
    "node": ">=26"
  },
  "main": "index.js",
  "scripts": {
    "build": "npx rimraf dist && tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build && npm run lint && npm run test"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/HuggingFaceSpaceApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/HuggingFaceSpace/HuggingFaceSpace.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-n8n-nodes-base": "^2.0.0",
    "globals": "^17.11.0",
    "gulp": "^5.0.1",
    "jsonc-eslint-parser": "^2.4.2",
    "n8n-workflow": "~2.35.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "overrides": {
    "nanoid": "^3.3.18"
  }
}
